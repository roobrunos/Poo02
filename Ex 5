package Ex5;

public class TestePagamento {
    public static void main(String[] args) {
        Pagamento pagamento1 = new PagamentoCartao(100.0);
        Pagamento pagamento2 = new PagamentoBoleto(200.0);

        pagamento1.exibirDetalhes();
        System.out.println("----------------------");
        pagamento2.exibirDetalhes();
    }
}

_________________________________________

package Ex5;

public class PagamentoCartao extends Pagamento {
    private static final double TAXA = 0.02; // 2% de taxa


    public PagamentoCartao(double valor) {
        super(valor);
    }

    @Override
    public double calcularValor() {
        return valor + (valor * TAXA);
    }
    @Override
    public void exibirDetalhes() {
        System.out.println("Pagamento via Cartão:");
        super.exibirDetalhes();
        System.out.println("Valor com taxa de 2%: R$ " + calcularValor());
    }
}
