package Ex7;

// Classe para testar os funcionários e o polimorfismo
public class TesteFuncionarios {
    public static void main(String[] args) {
        Funcionario gerente = new Gerente("Ana Silva", 8000);
        Funcionario desenvolvedor = new Desenvolvedor("Carlos Souza", 5000);

        // Exibir detalhes e bônus dos funcionários
        gerente.exibirDetalhes();
        System.out.println("Bônus: R$ " + gerente.calcularBonus());
        System.out.println();

        desenvolvedor.exibirDetalhes();
        System.out.println("Bônus: R$ " + desenvolvedor.calcularBonus());
    }
}

