package Ex6;

public class TesteFormas {
    public static void main(String[] args) {
        // Criando instâncias das formas geométricas usando polimorfismo
        Forma retangulo = new Retangulo(5, 10);
        Forma triangulo = new Triangulo(6, 8);
        Forma circulo = new Circulo(7);

        // Mostra as áreas diretamente chamando calcularArea()
        System.out.println("Área do Retângulo: " + retangulo.calcularArea());
        System.out.println("Área do Triângulo: " + triangulo.calcularArea());
        System.out.println("Área do Círculo: " + circulo.calcularArea());
    }
}

