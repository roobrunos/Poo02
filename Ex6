package Ex6;

public interface Forma {
    double calcularArea();
}
_______________________

package Ex6;

public class Circulo implements Forma {
    private double raio;
    private static final double PI = 3.1416;

    // construtor
    public Circulo(double raio) {
        this.raio = raio;
    }
    // Implementacao do metodo
    @Override
    public double calcularArea() {
        return PI * raio * raio;
    }

}

