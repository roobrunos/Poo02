package Ex6;

public class Triangulo implements Forma {
    private double base;
    private double altura;

    // construtor
    public Triangulo(double base, double altura) {
        this.base = base;
        this.altura = altura;
    }

    // implementacao do metodo
    @Override
    public double calcularArea() {
        return (base * altura) / 2;
    }


}
